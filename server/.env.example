# Use development only on a local machine. Set NODE_ENV=production when deployed.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Valid SMTP credentials are required to send password reset codes by email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=replace-with-an-email-provider-app-password
SMTP_FROM=ExamForge <your-email@example.com>
PASSWORD_RESET_OTP_EXPIRES_MINUTES=10

# Seed scripts are dry-run by default. For an explicit apply, point them at an
# isolated development/test database and set these values (not a production DB).
# SEED_DATABASE_NAME=ExamForge_DEV
# SEED_INSTRUCTOR_ID=<development-instructor-object-id>
